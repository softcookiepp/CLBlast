 struct vec2_t { vec2 s; };
 struct vec4_t { vec4 s; };
 struct vec8_t { float s[8]; };
 struct vec16_t { float s[16]; };





















































































































































































































































































































































































 int GetGroupID1() { return int(gl_WorkGroupID[1]); }

 int GetGroupID0() { return int(gl_WorkGroupID[0]); }






















































































































































































































































































































































































































































































































































































































































































































































































































    float InitAccRegisters() {
     float result;

                  result = float(0.0f);



 return result;
}





 layout(binding = 0, std430) buffer arg_alphas_buf { float arg_alphas[]; };
 layout(binding = 1, std430) buffer arg_betas_buf { float arg_betas[]; };
 layout(binding = 2, std430) buffer agm_buf { float agm[]; };
 layout(binding = 3, std430) buffer bgm_buf { float bgm[]; };
 layout(binding = 4, std430) buffer cgm_buf { float cgm[]; };

 layout(binding = 5, std430) buffer agms_buf { float a_ptr[]; };
 layout(binding = 6, std430) buffer bgms_buf { float b_ptr[]; };



shared float alm[32 * 16 / 1];
shared float blm[32 * 64 / 1];






void GlobalToLocalA(



  int a_offset,


 const int kSizeM, const int tid, const int kwg)
{
 const int la0 = tid % 8;
 const int la1 = tid / 8;

 for (int _mia = 0; _mia < (16 / 8) / 1; _mia += 1)
 {
  for (int _kia = 0; _kia < (32 / ( (8 * 8) / (8))); _kia += 1)
  {


    int mg = _mia + la0 * ( (16 / 8) / 1);





   int kg = _kia + la1 * (32 / ( (8 * 8) / (8)));
   int idm = mg + GetGroupID0() * (16 / 1);
   int idk = kg + kwg;


   alm[kg * (16 / 1) + mg] = agm[idk * (kSizeM / 1) + idm + a_offset];
  }
 }
}



void GlobalToLocalB(



  int b_offset,


 const int kSizeN, const int tid, const int kwg)
{
 const int lb0 = tid % 8;
 const int lb1 = tid / 8;

 for (int _kib = 0; _kib < (32 / ( (8 * 8) / (8))); _kib += 1) {

  for (int _nib = 0; _nib < (64 / 8) / 1; _nib += 1) {



    int ng = _nib + lb0 * ( (64 / 8) / 1);





   int kg = _kib + lb1 * (32 / ( (8 * 8) / (8)));
   int idn = ng + GetGroupID1() * (64 / 1);
   int idk = kg + kwg;


   blm[kg * (64 / 1) + ng] = bgm[idk * (kSizeN / 1) + idn + b_offset];
  }
 }
}






    float GlobalToPrivateA(



  int a_offset,

 const int _mi, const int kSizeM, const int idk, const int kwg)
{


  int mg = _mi + int(gl_LocalInvocationID[0]) * ( (16 / 8) / 1);





 int idm = mg + GetGroupID0() * (16 / 1);


 return agm[idk * (kSizeM / 1) + idm + a_offset];
}



    float GlobalToPrivateB(



  int b_offset,

 const int _ni, const int kSizeN, const int idk)
{


  int ng = _ni + int(gl_LocalInvocationID[1]) * ( (64 / 8) / 1);





 int idn = ng + GetGroupID1() * (64 / 1);


 return bgm[idk * (kSizeN / 1) + idn + b_offset];
}





    float GlobalToPrivateA2D(



  int a_ptr_offset,

 const int tid_y, const int _ni, const int kSizeK, const int idk, const int _ki)
{








  const int a_index = (tid_y * (64 / 8) + _ni) * kSizeK + idk + _ki * 1 + a_ptr_offset;

   return a_ptr[a_index];

























































}


    float GlobalToPrivateB2D(



  int b_ptr_offset,

 const int tid_x, const int _mi, const int kSizeN, const int idk, const int _ki)
{








  const int b_index = (idk + _ki) * kSizeN + tid_x * (16 / 8) + _mi * 1 + b_ptr_offset;

   return b_ptr[b_index];

























































}





    float LocalToPrivateA(

 const int _mi, const int kg)
{

  int mg = _mi + int(gl_LocalInvocationID[0]) * ( (16 / 8) / 1);



 return alm[kg * (16 / 1) + mg];
}



    float LocalToPrivateB(

 const int _ni, const int kg)
{

  int ng = _ni + int(gl_LocalInvocationID[1]) * ( (64 / 8) / 1);



 return blm[kg * (64 / 1) + ng];
}















































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































    float MultiplyAddVector(float cvec, const float avec, const float bval) {
 if (0 == 1)
 {
  cvec += avec * bval;
 }
 else
 {

                               cvec = fma(avec, bval, cvec);



 }
 return cvec;
}




ivec2 get_mg_ng_for_store(const int _mi, const int _ni)
{
 int mg;
 if (0 == 0)
  mg = _mi + int(gl_LocalInvocationID[0]) * ( (16 / 8) / 1);
 else if (0 == 1)
  mg = int(gl_LocalInvocationID[0]) + _mi * 8;
 int ng;
 if (0 == 0)
  ng = _ni + int(gl_LocalInvocationID[1]) * (64 / 8);
 else if (0 == 1)
  ng = _ni % 1 + int(gl_LocalInvocationID[1]) * 1 + (_ni / 1) * 1 * 8;
 return ivec2(mg, ng);
}



void StoreResults(



   int c_offset,

      float c_value, const int _mi, const int _ni,
  const int kSizeM, const float alpha, const float beta)
{
 ivec2 mgng = get_mg_ng_for_store(_mi, _ni);
 int mg = mgng[0];
 int ng = mgng[1];
 int idm = mg + GetGroupID0() * (16 / 1);
 int idn = ng + GetGroupID1() * 64;
 int index = idn * (kSizeM / 1) + idm;

     float result;
     float xval = c_value;


 if ( (beta == float(0.0f))) {

                               result = alpha * xval;



 }


 else {
      float yval = cgm[index + c_offset];

                                        result = alpha * xval + beta * yval;






 }
 cgm[index + c_offset] = result;
}



































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































void XgemmBody(const int kSizeM, const int kSizeN, const int kSizeK,




  int a_offset, int b_offset, int c_offset,

 const float alpha, const float beta)
{




      float apm[ (16 / 8) / 1];

      float bpm[ (64 / 8) / 1];











     float cpm[ (64 / 8) * ( (16 / 8) / 1)];

 int tid_x, tid_y, tid;
 int a_ptr_offset, b_ptr_offset;
 if (0 == 1)
 {





   a_ptr_offset = a_offset * 1;
   b_ptr_offset = b_offset * 1;

  tid_x = int(gl_LocalInvocationID[0]) + 8 * GetGroupID0();
  tid_y = int(gl_LocalInvocationID[1]) + 8 * GetGroupID1();
 }


 if (0 == 1 || 0 == 1)
  tid = int(gl_LocalInvocationID[0]) + 8 * int(gl_LocalInvocationID[1]);



 for (int _mi = 0; _mi < (16 / 8) / 1; _mi += 1) {

  for (int _ni = 0; _ni < (64 / 8); _ni += 1) {
   cpm[_ni * ( (16 / 8) / 1) + _mi] = InitAccRegisters();
  }
 }


 [[unroll]]
 for (int kwg = 0; kwg < kSizeK; kwg += 32 * 1)
 {

  if (0 == 1)
   GlobalToLocalA(



     a_offset,


    kSizeM, tid, kwg);


  if (0 == 1)
   GlobalToLocalB(



     b_offset,


    kSizeN, tid, kwg);

  if (0 == 1 || 0 == 1)
   barrier();


  for (int pwi = 0; pwi < 32 * 1; pwi += 2 * 1) {

   for (int _pit = 0; _pit < 2 * 1; _pit += 1)
   {
    int idk;
    int kg;
    if (0 == 0 || 0 == 0)
     idk = kwg + pwi + _pit;
    if (0 == 1 || 0 == 1)
     kg = pwi + _pit;



    for (int _mi = 0; _mi < (16 / 8) / 1; _mi += 1) {

     if (0 == 0 && 0 == 1)
     {
      apm[_mi] = LocalToPrivateA(
       _mi, kg);
     }

     else if (0 == 0 && 0 == 0)
     {
      apm[_mi] = GlobalToPrivateA(



        a_offset,

       _mi, kSizeM, idk, kwg);
     }

     else if (0 == 1)
     {
      for (int _ki = 0; _ki < 1; _ki += 1)
      {
       bpm[_ki * ( (16 / 8) / 1) + _mi] = GlobalToPrivateB2D(



         b_ptr_offset,

        tid_x, _mi, kSizeN, idk, _ki);
      }
     }
    }


    if (0 == 0)
    {
     for (int _ni = 0; _ni < (64 / 8) / 1; _ni += 1)
     {

      if (0 == 1)
       bpm[_ni] = LocalToPrivateB(
        _ni, kg);

      else
       bpm[_ni] = GlobalToPrivateB(



         b_offset,

        _ni, kSizeN, idk);
     }
    }
    else if (0 == 1)
    {
















      for (int _ni = 0; _ni < (64 / 8); _ni += 1) {

       for (int _ki = 0; _ki < 1 / 1; _ki += 1) {
        apm[_ni * (1 / 1) + _ki] = GlobalToPrivateA2D(



          a_ptr_offset,

         tid_y, _ni, kSizeK, idk, _ki);
       }
      }

    }


    if (0 == 0)

     for (int _ni = 0; _ni < (64 / 8) / 1; _ni += 1) {

      for (int _mi = 0; _mi < (16 / 8) / 1; _mi += 1) {
       const float aval = apm[_mi];

        cpm[ (_ni * 1 + 0) * ( (16 / 8) / 1) + _mi] = MultiplyAddVector(cpm[ (_ni * 1 + 0) * ( (16 / 8) / 1) + _mi], aval, bpm[_ni]);





      }
     }
    else if (0 == 1)

     for (int _ni = 0; _ni < (64 / 8); _ni += 1) {

      for (int _mi = 0; _mi < (16 / 8) / 1; _mi += 1) {

       for (int _ki = 0; _ki < 1 / 1; _ki += 1) {



         const float aval = apm[_ni * (1 / 1) + _ki];


         cpm[_ni * ( (16 / 8) / 1) + _mi] = MultiplyAddVector(cpm[_ni * ( (16 / 8) / 1) + _mi], bpm[ (1 * _ki + 0) * ( (16 / 8) / 1) + _mi], aval);





       }
      }
     }
    }
   }
  }
  if (0 == 1 || 0 == 1)
   barrier();
 }


 int cld = kSizeM;
 if (0 == 0)
  cld = kSizeM;
 else if (0 == 1)
  cld = kSizeN;

 for (int _ni = 0; _ni < (64 / 8); _ni += 1) {

  for (int _mi = 0; _mi < (16 / 8) / 1; _mi += 1) {
   StoreResults(



     c_offset,

    cpm[_ni * ( (16 / 8) / 1) + _mi], _mi, _ni, cld, alpha, beta);
  }
 }
}







 layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;


layout(push_constant, std430) uniform XgemmBatched
{
 int kSizeM; int kSizeN; int kSizeK;





 int a_one; int a_two;



 int b_one; int b_two;



 int c_one; int c_two;
};

void main()
{
 const int batch = int(gl_WorkGroupID[2]);
 const float alpha = float(arg_alphas[batch]);
 const float beta = float(arg_betas[batch]);


 const int a_offset = batch * a_one * a_two;
 const int b_offset = batch * b_one * b_two;
 const int c_offset = batch * c_one * c_two;







 XgemmBody(kSizeM, kSizeN, kSizeK,



  a_offset, b_offset, c_offset,

  alpha, beta
 );
}

